# Copie este arquivo para .env (ou exporte as mesmas variáveis no seu shell/IDE)
# antes de rodar com o profile "dev". Nunca commite o .env real.
#
# Esses mesmos valores também são lidos pelo docker-compose.yml para subir
# o Postgres local (docker compose up -d db).

DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5435

# Ainda não consumido pelo código (JWT entra em uma fase futura do roteiro), mas já
# fica fora do application-dev.properties para não vazar segredo nenhum.
JWT_SECRET=changeme-generate-a-real-secret
JWT_EXPIRATION=3600000
