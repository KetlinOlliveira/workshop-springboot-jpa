# Copie este arquivo para .env (ou exporte as mesmas variáveis no seu shell/IDE)
# antes de rodar com o profile "dev". Nunca commite o .env real.
#
# Esses mesmos valores também são lidos pelo docker-compose.yml para subir
# o Postgres local (docker compose up -d db).

DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5435

# Usado para assinar/validar o JWT (HS256 — use pelo menos 32 caracteres aleatórios reais).
JWT_SECRET=changeme-generate-a-real-secret-with-at-least-32-chars
JWT_EXPIRATION=3600000

# CORS: domínio do front-end autorizado a chamar a API (opcional, "*" por padrão).
CORS_ALLOWED_ORIGIN=*
